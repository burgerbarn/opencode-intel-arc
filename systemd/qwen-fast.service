[Unit]
Description=Qwen 3.6 35B-A3B (MoE, fast mode) via llama.cpp (Vulkan, Intel Arc) on 127.0.0.1:1234 for opencode
# Conflicts= alone runs the stop and start in parallel: both models in memory, OOM kill. This ordering makes the stop finish first, in both directions.
After=network-online.target qwen-llama.service
# Only one model fits in memory: starting this stops the smart model, and the other way round
Conflicts=qwen-llama.service

[Service]
TimeoutStopSec=20
# Edit the two paths. Model: unsloth/Qwen3.6-35B-A3B-GGUF, Qwen3.6-35B-A3B-UD-IQ4_XS.gguf (17.7 GB)
ExecStart=%h/llama.cpp/build/bin/llama-server -m %h/models/Qwen3.6-35B-A3B-UD-IQ4_XS.gguf --alias qwen/qwen3.6-35b-a3b -ngl 99 -c 65536 -ub 512 -fa off --cache-ram 1024 --ctx-checkpoints 4 --parallel 1 --jinja --host 127.0.0.1 --port 1234
Restart=on-failure
RestartSec=5
