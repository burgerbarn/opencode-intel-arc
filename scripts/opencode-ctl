#!/bin/bash
# opencode-ctl start|stop|status|logs - local OpenCode (llama.cpp model + Playwright + OpenCode web)
export XDG_RUNTIME_DIR=/run/user/$(id -u)
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}
U="qwen-llama.service opencode-playwright.service opencode.service"
URL=http://localhost:4096
note() { notify-send -a OpenCode -i "$1" "$2" "$3" 2>/dev/null || true; echo "$2: $3"; }
model_ok() { curl -s -m 2 http://127.0.0.1:1234/health | grep -q ok; }
web_ok()   { curl -s -o /dev/null -m 2 http://127.0.0.1:4096/; }
fail() {
  local u=$1; local why
  why=$(journalctl --user -u "$u" -n 3 --no-pager -o cat 2>/dev/null | tail -1 | cut -c1-200)
  note dialog-error "OpenCode failed to start" "$u: ${why:-no log}  (opencode-ctl logs)"
  exit 1
}
case "$1" in
  start)
    if systemctl --user is-active -q $U && model_ok && web_ok; then
      [ "$2" = "--no-open" ] || xdg-open $URL >/dev/null 2>&1
      note utilities-terminal "OpenCode is already running" "$URL"; exit 0
    fi
    note utilities-terminal "Starting OpenCode" "Loading Qwen 3.8 27B on the GPU..."
    systemctl --user start $U || fail opencode.service
    for i in $(seq 1 90); do model_ok && break; systemctl --user is-failed -q qwen-llama.service && fail qwen-llama.service; sleep 2; done
    model_ok || fail qwen-llama.service
    for i in $(seq 1 30); do web_ok && break; sleep 1; done
    web_ok || fail opencode.service
    [ "$2" = "--no-open" ] || xdg-open $URL >/dev/null 2>&1
    note utilities-terminal "OpenCode is ready" "$URL  (also http://$(hostname -I | awk '{print $1}'):4096 on the LAN)"
    ;;
  stop)
    systemctl --user stop opencode.service opencode-playwright.service qwen-llama.service
    note process-stop "OpenCode stopped" "Model unloaded, GPU memory freed"
    ;;
  status) for u in $U; do printf "%-28s %s\n" "$u" "$(systemctl --user is-active $u)"; done
          model_ok && echo "model: ready" || echo "model: not ready"; web_ok && echo "web: $URL" || echo "web: down" ;;
  logs)   journalctl --user -u qwen-llama.service -u opencode.service -u opencode-playwright.service -n ${2:-40} --no-pager -o short ;;
  *) echo "usage: opencode-ctl start [--no-open] | stop | status | logs [n]"; exit 2 ;;
esac
